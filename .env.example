# ==============================================================================
# rhp-migrate-ai Self-Hosted Deployment Configuration (.env.example)
#
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Port Bindings
# ------------------------------------------------------------------------------
# Port for the Next.js frontend web application (Workbench UI)
WEB_PORT=3000

# Port for the FastAPI backend REST & SSE API
API_PORT=8000

# Port for local Ollama service (when running with --profile local-llm)
OLLAMA_PORT=11434

# ------------------------------------------------------------------------------
# 2. Workspace & Storage Paths
# ------------------------------------------------------------------------------
# Persistent storage root directory inside the api container
RHP_WORKSPACE_ROOT=/data

# Location of fast working memory learnings.md file
RHP_LEARNINGS_PATH=/data/learnings.md

# Directory containing custom rules.yaml and context.md
RHP_RULES_DIR=/data/rules

# Directory for extracted upload workspaces & clones
RHP_WORKSPACES_DIR=/data/workspaces

# Optional host directory if using bind mount instead of named volume
# HOST_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 3. CORS & Networking Settings
# ------------------------------------------------------------------------------
# Allowed CORS origins for FastAPI backend.
# Set to '*' for open internal VPC access, or comma-separated list of origins:
# e.g.: CORS_ORIGINS=http://localhost:3000,https://migrate.internal.company.com
CORS_ORIGINS=*

# Backend URL used by Next.js server proxy (internal container DNS)
BACKEND_API_URL=http://api:8000

# ------------------------------------------------------------------------------
# 4. Optional Default LLM Provider API Keys (BYOK Fallback)
# Note: Users can always provide their own keys in the Workbench UI via BYOK headers.
# Supplying keys here sets server-level default credentials.
# ------------------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# DeepSeek API Key
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local Offline Air-Gapped LLM (Ollama)
# ------------------------------------------------------------------------------
# Endpoint for Ollama LLM provider (defaults to the compose network service)
OLLAMA_API_BASE=http://ollama:11434

# Recommended Ollama model tag for code migration (e.g. llama3, qwen2.5-coder:7b)
OLLAMA_MODEL=llama3

# Uncomment below to activate local Ollama by default without specifying --profile:
# COMPOSE_PROFILES=local-llm

# Optional custom LiteLLM base URL override
# LITELLM_API_BASE=
